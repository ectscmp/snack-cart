# SQLite database file.
# Local: ./data/app.db
# Railway: mount a volume at /data and use /data/app.db
DATABASE_PATH=./data/app.db

# Auth.js session encryption key.
# Generate one with: npx auth secret
AUTH_SECRET=

# Public URL of the app. Use your Railway/custom domain in production.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Microsoft Entra ID app registration.
# Azure Portal -> Microsoft Entra ID -> App registrations -> your app.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Tenant-specific issuer restricts sign-in to your organization.
# Replace <tenant-id> with the Directory (tenant) ID.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Comma-separated emails that become admins on first sign-in.
# This is the bootstrap path so you always have a way into /admin.
ADMIN_EMAILS=

# Optional deploy fallback when the matching field in Admin → Settings is blank.
# Comma-separated Entra group object IDs.
# ENTRA_ADMIN_GROUPS=
# ENTRA_STAFF_GROUPS=
